# ------------------------------------------------------------------
# CFO Sentinel — environment template. Copy to `.env` and fill in.
# Never commit real secrets.
# ------------------------------------------------------------------

# PostgreSQL connection used by Prisma + Next.js.
# Docker Compose default (see docker-compose.yml):
DATABASE_URL="postgresql://cfo:cfo_secret@localhost:5432/cfo_sentinel?schema=public"

# OpenAI API key for the Investigator Agent. Required to run
# `POST /api/incidents/[id]/investigate`. NEVER used by deterministic
# financial services/tools (they never call the LLM).
# Free default backend: Groq (no credit card). Sign up at
# https://console.groq.com, create an API key, and set GROQ_API_KEY.
# The default MODEL_NAME + OPENAI_BASE_URL below already point at Groq.
GROQ_API_KEY=""
OPENAI_API_KEY=""

# Base URL for the OpenAI-compatible chat API. Defaults to Groq's free tier;
# point at https://api.openai.com/v1 (with an OpenAI key) to go back.
OPENAI_BASE_URL="https://api.groq.com/openai/v1"

# Model name for agent runs. Default is openai/gpt-oss-120b on Groq
# (strong tool-calling; Groq retires model ids periodically — if the
# Investigator 404s on the model, list current ids via the /models endpoint
# and set MODEL_NAME to a served chat model). Kept as plain
# config so model selection never gets hardcoded in source.
MODEL_NAME="openai/gpt-oss-120b"

# --- Optional rate limiting (Investigations) -----------------------
# Default: 10 investigations / org / minute (sliding window).
# Set RATE_LIMIT_MAX_REQUESTS=0 to disable the limiter entirely.
# RATE_LIMIT_MAX_REQUESTS="10"
# RATE_LIMIT_WINDOW_MS="60000"

# --- Dodo Payments connector (read-only pull) ----------------------
# Test-mode key from Developer > API Keys in the Dodo dashboard.
# Deterministic services and the seeded demo do not need it.
# DODO_PAYMENTS_API_KEY=""
# DODO_PAYMENTS_WEBHOOK_KEY=""
# DODO_PAYMENTS_ENVIRONMENT="test_mode" # "test_mode" or "live_mode"
# Bank account (by name) receiving promoted payouts. Must exist in the org.
# DODO_PAYOUT_BANK_NAME="Operating Checking"
